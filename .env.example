# Ainvestment Configuration
# Copy this file to .env and fill in your values

# ========== LLM Configuration ==========
# Options: mock | ollama | openai
LLM_PROVIDER=mock

# OpenAI (if using)
# OPENAI_API_KEY=sk-your-key-here

# Ollama (if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ========== News API ==========
# Get free key from https://newsapi.org (100 req/day)
# NEWSAPI_KEY=your-newsapi-key-here
NEWSAPI_ENABLED=false

# ========== Cache Configuration ==========
CACHE_ENABLED=true
CACHE_TTL_HOURS=24
CACHE_DB_PATH=.cache/ainvestment.db

# ========== Budget Limits ==========
# Prevent runaway costs
DAILY_TOKEN_LIMIT=100000
MONTHLY_BUDGET_USD=5.00
MAX_REQUESTS_PER_HOUR=100

# ========== Data Configuration ==========
DEFAULT_PERIOD=1y
TIMEOUT_SECONDS=10
MAX_RETRIES=3

# ========== News Configuration ==========
NEWS_DAYS_BACK=7
NEWS_MIN_ARTICLES=3
NEWS_MAX_ARTICLES=20

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_FORMAT=json
